# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-to-a-secure-random-string-in-production

# Authentication & JWT
JWT_SECRET=supersecretkey-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/rag_engine
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/rag_engine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_engine
POSTGRES_PORT=5433

# Redis Queue & Cache
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=documents
S3_REGION=us-east-1
S3_SECURE=false

# Model Provider (mock, gemini, openai)
MODEL_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
COMPLETION_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

# RAG & Chunking
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=8
MIN_RELEVANCE_SCORE=0.3

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
